      return '<div class="cart-item"><img src="'+imgForKey(key)+'" alt="'+altForKey(key)+'"><div><b>'+name+'</b><span class="cp">'+rp(price)+' /ekor • '+rp(price*cart[key])+'</span><br>'
        + '<span class="qty"><button data-dec="'+key+'" aria-label="Kurangi">−</button><span>'+cart[key]+'</span><button data-inc="'+key+'" aria-label="Tambah">+</button></span></div>'
        + '<button class="icon-btn remove" data-remove="'+key+'" aria-label="Hapus dari keranjang">🗑</button></div>';
    }).join("");
  }
  el("cartTotal").textContent = rp(cartMoneyTotal());
}

function showToast(msg){ var t=el("toast"); t.textContent=msg; t.classList.add("show"); setTimeout(function(){t.classList.remove("show")},2200); }
function addToCart(key, open){
  cart[key]=(cart[key]||0)+1; renderCart();
  showToast(displayNameForKey(key)+" ditambahkan ke keranjang 🐟");
  if(open) openCartDrawer();
}
function openCartDrawer(){ el("cartDrawer").classList.add("open"); el("overlay").classList.add("show"); }
function closeCartDrawer(){ el("cartDrawer").classList.remove("open"); el("overlay").classList.remove("show"); }

function updateModalPrice(){
  var p=findProduct(modalId); if(!p) return;
  if(p.variants && p.variants.length){
    var v=getVariant(p, modalVariant) || p.variants[0];
    modalVariant=v.key;
    el("mPrice").textContent=rp(v.price);
    el("mPriceSuffix").textContent="per ekor • "+v.label+" • Size induk";
    el("mWa").href="https://wa.me/"+WA_NUMBER+"?text="+encodeURIComponent("Halo Dahrul Khalam, saya mau tanya stok "+p.name+" "+v.label+" size induk ("+rp(v.price)+"/ekor)");
    var opts=el("mVariantOptions");
    if(opts){ opts.querySelectorAll("[data-variant]").forEach(function(b){ b.classList.toggle("active", b.getAttribute("data-variant")===modalVariant); }); }
  } else {
    el("mPrice").textContent=rp(p.price);
    el("mPriceSuffix").textContent="per ekor";
    el("mWa").href="https://wa.me/"+WA_NUMBER+"?text="+encodeURIComponent("Halo Dahrul Khalam, saya mau tanya stok "+p.name+" ("+rp(p.price)+"/ekor)");
  }
}
function openDetail(id){
  var p=findProduct(id); if(!p) return;
  modalId=id;
  modalVariant = (p.variants && p.variants.length) ? p.variants[0].key : null;
  var galList = (p.gallery && p.gallery.length) ? p.gallery : [p.img];
  modalGallery = galList; modalSlide = 0;
  el("mTrack").innerHTML = galList.map(function(src,i){ var a=(p.galleryAlts && p.galleryAlts[i]) ? p.galleryAlts[i] : p.alt; return '<div class="gallery-slide"><img draggable="false" src="'+src+'" alt="'+a+'"></div>'; }).join("");
  el("mDots").innerHTML = galList.length>1 ? galList.map(function(_,i){ return '<button type="button" data-modal-dot="'+i+'" class="'+(i===0?"active":"")+'" aria-label="Foto '+(i+1)+'"></button>'; }).join("") : "";
  el("mPrev").hidden = galList.length<2; el("mNext").hidden = galList.length<2;
  el("mHint").style.display = galList.length>1 ? "" : "none";
  el("mDots").style.display = galList.length>1 ? "" : "none";
  var thumbs=el("mThumbs");
  if(galList.length>1){
    thumbs.classList.add("show");
    thumbs.innerHTML=galList.map(function(src,i){ return '<button type="button" data-thumb-idx="'+i+'" class="'+(i===0?"active":"")+'" aria-label="Lihat foto '+(i+1)+'"><img src="'+src+'" alt=""></button>'; }).join("");
  } else { thumbs.classList.remove("show"); thumbs.innerHTML=""; }
  setModalSlide(0);
  el("mBadge").textContent=p.badge+" • "+p.stock;
  el("mName").textContent=p.name; el("mLatin").textContent=p.latin;
  el("mDesc").textContent=p.desc; el("mSize").textContent=p.size;
  var vBox=el("mVariantBox"); var vOpts=el("mVariantOptions");
  if(p.variants && p.variants.length){
    vBox.style.display="block";
    vOpts.innerHTML=p.variants.map(function(v){ return '<button type="button" class="variant-btn'+(v.key===modalVariant?" active":"")+'" data-variant="'+v.key+'">'+v.label+' — '+rp(v.price)+'</button>'; }).join("");
  } else { vBox.style.display="none"; vOpts.innerHTML=""; }
  updateModalPrice();
  el("detailModal").classList.add("show");
}
function closeDetail(){ el("detailModal").classList.remove("show"); }

document.addEventListener("click", function(e){
  var addVar=e.target.closest("[data-add-var]"); if(addVar){ addToCart(addVar.getAttribute("data-add-var"), false); return; }
  var add=e.target.closest("[data-add]"); if(add){ addToCart(add.getAttribute("data-add"), false); return; }
  var cardDot=e.target.closest("[data-card-dot]"); if(cardDot){ var cg=cardDot.closest("[data-card-gallery]"); if(cg) setCardSlide(cg, parseInt(cardDot.getAttribute("data-card-dot"),10)||0); suppressDetailUntil=Date.now()+350; return; }
  var det=e.target.closest("[data-detail]"); if(det){ if(Date.now()<suppressDetailUntil) return; openDetail(det.getAttribute("data-detail")); return; }
  var inc=e.target.closest("[data-inc]"); if(inc){ cart[inc.getAttribute("data-inc")]++; renderCart(); return; }
  var dec=e.target.closest("[data-dec]"); if(dec){ var id=dec.getAttribute("data-dec"); cart[id]--; if(cart[id]<=0) delete cart[id]; renderCart(); return; }
  var rem=e.target.closest("[data-remove]"); if(rem){ delete cart[rem.getAttribute("data-remove")]; renderCart(); return; }
});
el("filters").addEventListener("click", function(e){
  var chip=e.target.closest(".chip"); if(!chip) return;
  document.querySelectorAll(".chip").forEach(function(c){c.classList.remove("active")});
  chip.classList.add("active"); activeFilter=chip.getAttribute("data-filter"); renderProducts();
});
el("searchInput").addEventListener("input", renderProducts);
el("shipPicker").addEventListener("click", function(e){
  var b=e.target.closest("[data-courier]"); if(!b) return;
  selectedCourier=b.getAttribute("data-courier");
  renderShipping();
});
el("openCart").addEventListener("click", openCartDrawer);
el("closeCart").addEventListener("click", closeCartDrawer);
el("continueBtn").addEventListener("click", closeCartDrawer);
el("overlay").addEventListener("click", closeCartDrawer);
el("closeModal").addEventListener("click", closeDetail);
el("modalOverlay").addEventListener("click", closeDetail);
el("mThumbs").addEventListener("click", function(e){
  var b=e.target.closest("[data-thumb-idx]"); if(!b) return;
  setModalSlide(parseInt(b.getAttribute("data-thumb-idx"),10)||0);
});
el("mDots").addEventListener("click", function(e){
  var b=e.target.closest("[data-modal-dot]"); if(!b) return;
  setModalSlide(parseInt(b.getAttribute("data-modal-dot"),10)||0);
});
el("mPrev").addEventListener("click", function(){ setModalSlide(modalSlide-1); });
el("mNext").addEventListener("click", function(){ setModalSlide(modalSlide+1); });
attachDragSlider(el("mGallery"), el("mTrack"), function(){ return modalSlide; }, function(i){ setModalSlide(i); }, function(){ return modalGallery.length; });
el("mVariantOptions").addEventListener("click", function(e){
  var b=e.target.closest("[data-variant]"); if(!b) return;
  modalVariant=b.getAttribute("data-variant");
  updateModalPrice();
});
el("mAdd").addEventListener("click", function(){ if(modalId){ var p=findProduct(modalId); var key=modalId; if(p && p.variants && p.variants.length){ key=modalId+"__"+(modalVariant || p.variants[0].key); } addToCart(key,false); closeDetail(); openCartDrawer(); } });
function renderShipping(){
  document.querySelectorAll("#shipPicker [data-courier]").forEach(function(b){ b.classList.toggle("active", b.getAttribute("data-courier")===selectedCourier); });
  var info=el("shipInfo");
  if(info) info.innerHTML = 'Ekspedisi: <b>'+selectedCourier+'</b> • Pengiriman ke luar pulau disertai surat karantina.';
}
function escapeHtml(s){ return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function getRecipient(){
  return {
    name: el("recvName") ? el("recvName").value.trim() : "",
    phone: el("recvPhone") ? el("recvPhone").value.trim() : "",
    address: el("recvAddress") ? el("recvAddress").value.trim() : ""
  };
}
function validateRecipient(){
  var r=getRecipient();
  var missing=[];
  el("recvName").classList.toggle("invalid", !r.name);
  if(!r.name) missing.push("Nama penerima");
  var digits=r.phone.replace(/\D/g,"");
  var phoneOk = digits.length>=9 && digits.length<=15;
  el("recvPhone").classList.toggle("invalid", !phoneOk);
  if(!r.phone) missing.push("No HP"); else if(!phoneOk) missing.push("No HP yang valid (9–15 digit)");
  el("recvAddress").classList.toggle("invalid", !r.address);
  if(!r.address) missing.push("Alamat lengkap");
  var err=el("recvError");
  if(missing.length){
    err.textContent="Lengkapi dulu data penerima sebelum bayar: "+missing.join(", ")+".";
    err.classList.add("show");
  } else {
    err.textContent=""; err.classList.remove("show");
  }
  return {ok: missing.length===0, data:r};
}
["recvName","recvPhone","recvAddress"].forEach(function(id){
  var inp=el(id); if(!inp) return;
  inp.addEventListener("input", function(){ inp.classList.remove("invalid"); var err=el("recvError"); if(err){ err.classList.remove("show"); err.textContent=""; } });
});
function openQris(){
  var recipient=getRecipient();
  var ids=Object.keys(cart).filter(function(k){return cart[k]>0});
  var rows = ids.map(function(key){
    var price=priceForKey(key);
    return '<div><span>'+displayNameForKey(key)+' × '+cart[key]+' ekor</span><b>'+rp(price*cart[key])+'</b></div>';
  });
  rows.push('<div style="border-top:1px dashed var(--line);padding-top:8px;margin-top:4px"><span>Nama penerima</span><b>'+escapeHtml(recipient.name)+'</b></div>');
  rows.push('<div><span>No HP</span><b>'+escapeHtml(recipient.phone)+'</b></div>');
  rows.push('<div style="display:block"><span style="color:var(--muted)">Alamat pengiriman</span><b style="display:block;margin-top:2px;font-weight:700;line-height:1.45">'+escapeHtml(recipient.address)+'</b></div>');
  rows.push('<div><span>Ekspedisi dipilih</span><b>'+selectedCourier+'</b></div>');
  rows.push('<div><span>Surat karantina</span><b>Disertakan untuk luar pulau</b></div>');
  rows.push('<div><span>Ongkir ke seluruh Indonesia</span><b>Dihitung per kota tujuan &amp; ekspedisi — belum termasuk total ini</b></div>');
  el("qrisSummary").innerHTML = rows.join("");
  el("qrisTotal").textContent = rp(cartMoneyTotal());
  var sn=el("qrisShipNote");
  if(sn) sn.textContent = 'Total di atas adalah harga ikan, belum termasuk ongkir. Ekspedisi dipilih: '+selectedCourier+'. Ongkir ke seluruh Indonesia dihitung berdasarkan kota / alamat tujuan dan ekspedisi yang dipilih (TIKI, JNE, atau J&T), dibayar pembeli, dan dikonfirmasi berdasarkan alamat tujuanmu. Pengiriman ke luar pulau disertai surat karantina. Ada pertanyaan soal stok atau pengiriman? WhatsApp 085194259047 hanya untuk tanya-tanya, bukan untuk checkout / pembayaran.';
  el("qrisModal").classList.add("show");
}
function closeQris(){ el("qrisModal").classList.remove("show"); }
el("checkoutBtn").addEventListener("click", function(){
  var ids=Object.keys(cart).filter(function(k){return cart[k]>0});
  if(!ids.length){ showToast("Keranjang masih kosong — pilih molly dulu ya 🐠"); return; }
  var v=validateRecipient();
  if(!v.ok){
    showToast("Isi Nama penerima, Alamat, dan No HP dulu ya 📦");
    var form=el("recipientForm");
    if(form) form.scrollIntoView({behavior:"smooth", block:"center"});
    return;
  }
  closeCartDrawer();
  openQris();
});
el("closeQris").addEventListener("click", closeQris);
el("qrisOverlay").addEventListener("click", closeQris);
el("qrisBackBtn").addEventListener("click", function(){ closeQris(); openCartDrawer(); });
el("qrisDoneBtn").addEventListener("click", function(){
  cart = {}; renderCart(); closeQris();
  ["recvName","recvPhone","recvAddress"].forEach(function(id){ var inp=el(id); if(inp){ inp.value=""; inp.classList.remove("invalid"); } });
  var err=el("recvError"); if(err){ err.classList.remove("show"); err.textContent=""; }
  showToast("Terima kasih! Pesananmu kami siapkan setelah pembayaran QRIS 🐟");
});
document.querySelectorAll(".faq button").forEach(function(btn){
  btn.addEventListener("click", function(){
    var item=btn.parentElement; var wasOpen=item.classList.contains("open");
    document.querySelectorAll(".faq").forEach(function(f){f.classList.remove("open")});
    if(!wasOpen) item.classList.add("open");
  });
});
document.addEventListener("keydown", function(e){
  if(e.key==="Escape"){ closeDetail(); closeCartDrawer(); closeQris(); }
  if(el("detailModal").classList.contains("show")){
    if(e.key==="ArrowRight") setModalSlide(modalSlide+1);
    if(e.key==="ArrowLeft") setModalSlide(modalSlide-1);
  }
});

/* hero slider */
var heroIdx = 0;
var heroTrack = el("heroTrack");
var heroCount = heroTrack ? heroTrack.children.length : 0;
function setHeroSlide(idx){
  if(!heroTrack || !heroCount) return;
  heroIdx = Math.max(0, Math.min(heroCount-1, idx));
  heroTrack.style.transform = "translateX(" + (-heroIdx*100) + "%)";
  el("heroDots").querySelectorAll("button").forEach(function(d,i){ d.classList.toggle("active", i===heroIdx); });
}
if(heroTrack && heroCount>1){
  el("heroDots").innerHTML = Array.prototype.map.call(heroTrack.children, function(_,i){ return '<button type="button" data-hero-dot="'+i+'" class="'+(i===0?"active":"")+'" aria-label="Foto utama '+(i+1)+'"></button>'; }).join("");
  el("heroDots").addEventListener("click", function(e){
    var b=e.target.closest("[data-hero-dot]"); if(!b) return;
    setHeroSlide(parseInt(b.getAttribute("data-hero-dot"),10)||0);
  });
  attachDragSlider(el("heroMedia"), heroTrack, function(){ return heroIdx; }, function(i){ setHeroSlide(i); }, function(){ return heroCount; });
}

renderProducts(); renderCart(); renderShipping();
</script>
</body>
</html>

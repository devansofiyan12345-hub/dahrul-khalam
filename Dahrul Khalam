/* ---------- Swipe / drag galleries ---------- */
var suppressDetailUntil = 0;
var lastPointerDragEnd = 0;
function attachDragSlider(elm, track, getIdx, setIdx, getCount, onDragEnd){
  if(!elm || !track || elm.__dragBound) return; elm.__dragBound = true;
  elm.addEventListener("dragstart", function(e){ e.preventDefault(); });
  var startX=0, startY=0, baseIdx=0, width=1, dragging=false, moved=false;
  function onMove(e){
    if(!dragging) return;
    var dx=e.clientX-startX, dy=e.clientY-startY;
    if(!moved && Math.abs(dx)>6 && Math.abs(dx)>Math.abs(dy)) moved=true;
    if(!moved) return;
    var n=getCount(); if(n<2) return;
    var offset=-baseIdx*width+dx;
    var min=-(n-1)*width;
    if(offset>50) offset=50;
    if(offset<min-50) offset=min-50;
    track.style.transform="translateX("+offset+"px)";
  }
  function onEnd(e){
    window.removeEventListener("pointermove", onMove);
    window.removeEventListener("pointerup", onEnd);
    window.removeEventListener("pointercancel", onEnd);
    if(!dragging) return; dragging=false;
    elm.classList.remove("dragging");
    track.style.transition="";
    lastPointerDragEnd=Date.now();
    var dx=(e && typeof e.clientX==="number") ? e.clientX-startX : 0;
    if(moved && Math.abs(dx)>=Math.min(60, width*0.18)){
      setIdx(baseIdx+(dx<0?1:-1));
    } else {
      setIdx(baseIdx);
    }
    if(moved && onDragEnd) onDragEnd();
    moved=false;
  }
  elm.addEventListener("pointerdown", function(e){
    if(e.button!==undefined && e.button!==0) return;
    if(getCount()<2) return;
    dragging=true; moved=false;
    startX=e.clientX; startY=e.clientY;
    baseIdx=getIdx(); width=elm.clientWidth||1;
    track.style.transition="none";
    elm.classList.add("dragging");
    window.addEventListener("pointermove", onMove);
    window.addEventListener("pointerup", onEnd);
    window.addEventListener("pointercancel", onEnd);
  });
  /* Fallback swipe sentuh untuk webview lama tanpa Pointer Events */
  var tsx=0, tsy=0;
  elm.addEventListener("touchstart", function(e){ var t=e.changedTouches[0]; tsx=t.clientX; tsy=t.clientY; }, {passive:true});
  elm.addEventListener("touchend", function(e){
    if(Date.now()-lastPointerDragEnd<600) return;
    var t=e.changedTouches[0]; var dx=t.clientX-tsx; var dy=t.clientY-tsy;
    if(Math.abs(dx)>=40 && Math.abs(dx)>Math.abs(dy)*1.2){

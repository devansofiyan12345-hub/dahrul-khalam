<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<title>Dahrul Khalam — Toko Ikan Molly Premium Indonesia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F7F4ED; --bg2:#EFE9DC; --surface:#FFFFFF; --surface2:#F1EDE3;
  --ink:#17211F; --muted:#5C6B67; --line:#E2DCCF;
  --teal:#0E4F4A; --teal2:#0A3A36; --teal-soft:#DCEEE9;
  --orange:#E86A1C; --orange-d:#C6530F; --gold:#E9A426; --wa:#1FA855;
  --radius:18px; --shadow:0 10px 30px rgba(20,40,35,.10);
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#0B1715; --bg2:#0E201D; --surface:#132623; --surface2:#182F2B; --ink:#EDF4F0; --muted:#9DB3AC; --line:#23403A; --teal-soft:#1C3D38; --shadow:0 10px 30px rgba(0,0,0,.35); }
}
*{box-sizing:border-box} html{scroll-behavior:smooth}
body{margin:0;font-family:"Plus Jakarta Sans",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55}
h1,h2,h3{font-family:"Sora",sans-serif;line-height:1.08;margin:0}
a{color:inherit} img{display:block;max-width:100%}
.wrap{width:min(1180px,100% - 32px);margin-inline:auto}
.btn{display:inline-flex;align-items:center;gap:8px;border:0;cursor:pointer;font-weight:800;font-size:15px;padding:13px 20px;border-radius:999px;text-decoration:none;transition:.18s}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--orange);color:#fff}.btn-primary:hover{background:var(--orange-d)}
.btn-teal{background:var(--teal);color:#fff}.btn-teal:hover{background:var(--teal2)}
.btn-wa{background:var(--wa);color:#fff}
.btn-ghost{background:var(--surface);border:1.5px solid var(--line);color:var(--ink)}
.btn-sm{padding:9px 14px;font-size:13.5px}

/* trust bar */
.trustbar{background:var(--teal2);color:#DFF2EC;font-size:12.5px;font-weight:600}
.trustbar .wrap{display:flex;gap:8px 22px;flex-wrap:wrap;justify-content:center;padding-top:8px;padding-bottom:8px}
.trustbar span{display:inline-flex;gap:6px;align-items:center;white-space:nowrap}
.trustbar b{color:#FFC24D}

/* header */
header.site{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
header.site .wrap{display:flex;align-items:center;gap:18px;padding-top:12px;padding-bottom:12px}
.logo{display:flex;align-items:center;gap:11px;text-decoration:none}
.logo-mark{width:42px;height:42px;border-radius:12px;background:var(--teal);color:#fff;display:grid;place-items:center;font-size:22px}
.logo-name{font-family:"Sora";font-weight:800;font-size:19px;line-height:1}
.logo-name small{display:block;font-family:"Plus Jakarta Sans";font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);margin-top:3px}
.logo-img{height:60px;width:auto;background:#fff;border:1px solid var(--line);border-radius:12px;padding:4px 6px;object-fit:contain}
.footer-logo{display:inline-block;background:#fff;border-radius:14px;padding:8px 10px;margin-bottom:14px;line-height:0}
.footer-logo img{width:230px;max-width:72vw;height:auto}
@media(max-width:820px){.logo-img{height:50px}}
nav.main{display:flex;gap:4px;margin-left:auto}
nav.main a{text-decoration:none;font-weight:600;font-size:14.5px;padding:8px 12px;border-radius:999px;color:var(--muted)}
nav.main a:hover{background:var(--surface2);color:var(--ink)}
.cart-btn{position:relative;margin-left:6px}
.cart-count{position:absolute;top:-6px;right:-6px;background:var(--orange);color:#fff;font-size:11px;font-weight:800;min-width:20px;height:20px;border-radius:999px;display:grid;place-items:center;padding:0 5px}
@media(max-width:820px){ nav.main{display:none} header.site .wrap{gap:10px} .cart-wrap{margin-left:auto} }

/* hero */
.hero{padding:34px 0 8px}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:28px;align-items:center}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr}}
.pill{display:inline-flex;gap:7px;align-items:center;background:var(--teal-soft);color:var(--teal);font-weight:700;font-size:12.5px;padding:6px 12px;border-radius:999px}
@media(prefers-color-scheme:dark){.pill{color:#8ED8C8}}
.hero h1{font-size:clamp(34px,5.2vw,58px);letter-spacing:-.02em;margin:16px 0 14px}
.hero h1 em{font-style:normal;color:var(--orange)}
.hero p.lead{font-size:17px;color:var(--muted);max-width:52ch;margin:0 0 22px}
.hero-cta{display:flex;gap:10px;flex-wrap:wrap}
.hero-stats{display:flex;gap:26px;flex-wrap:wrap;margin-top:26px;padding-top:20px;border-top:1px dashed var(--line)}
.hero-stats div b{font-family:"Sora";font-size:21px;display:block}
.hero-stats div span{font-size:12.5px;color:var(--muted);font-weight:600}
.hero-media{position:relative;border-radius:26px;box-shadow:var(--shadow);overflow:hidden;background:var(--surface2)}
.hero-track{display:flex;height:520px;transition:transform .38s ease;touch-action:pan-y}
@media(max-width:860px){.hero-track{height:340px}}
.hero-slide{flex:0 0 100%;min-width:100%}
.hero-media img.main{width:100%;height:100%;object-fit:cover}
.card-gallery,.gallery,.hero-media{cursor:grab}
.card-gallery.dragging,.gallery.dragging,.hero-media.dragging{cursor:grabbing}
.card-track img,.gallery-slide img,.hero-slide img{-webkit-user-drag:none;-webkit-user-select:none;user-select:none}
.slider-dots{display:flex;gap:6px;align-items:center}
.slider-dots button{width:8px;height:8px;border-radius:999px;border:0;padding:0;background:rgba(255,255,255,.55);cursor:pointer;transition:.2s}
.slider-dots button.active{width:22px;background:var(--orange)}
.hero-dots{position:absolute;top:14px;right:14px;z-index:3;background:rgba(10,30,27,.45);padding:7px 9px;border-radius:999px}
.hero-hint{position:absolute;top:14px;left:14px;z-index:3;background:rgba(10,30,27,.55);color:#fff;font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:999px}
.hero-card{position:absolute;left:14px;bottom:14px;right:14px;background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:16px;padding:13px 15px;display:flex;gap:12px;align-items:center}
.hero-card img{width:56px;height:56px;object-fit:cover;border-radius:10px}
.hero-card b{font-size:14.5px;display:block}
.hero-card span{font-size:12.5px;color:var(--muted)}
.hero-card .price{margin-left:auto;font-family:"Sora";font-weight:800;color:var(--orange);white-space:nowrap}

/* sections */
section{padding:52px 0 8px}
.sec-head{display:flex;align-items:end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:20px}
.kicker{font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);margin-bottom:8px}
.sec-head h2{font-size:clamp(26px,3.4vw,38px);letter-spacing:-.01em}
.sec-head p{color:var(--muted);max-width:56ch;margin:8px 0 0}

/* filters */
.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:18px}
.chip{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);font-weight:700;font-size:13.5px;padding:8px 15px;border-radius:999px;cursor:pointer}
.chip.active{background:var(--teal);border-color:var(--teal);color:#fff}
.search{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--surface);border:1.5px solid var(--line);border-radius:999px;padding:8px 14px;flex:1;max-width:280px;min-width:180px}
.search input{border:0;outline:0;background:transparent;font:inherit;font-size:14px;width:100%;color:var(--ink)}
@media(max-width:640px){.search{margin-left:0;max-width:none}}

/* product grid */
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:1020px){.grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:720px){.grid{grid-template-columns:repeat(2,1fr);gap:12px}}
@media(max-width:400px){.grid{grid-template-columns:1fr}}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column}
.card figure{margin:0;position:relative;cursor:pointer}
.card figure img{width:100%;height:190px;object-fit:cover}
@media(max-width:720px){.card figure img{height:150px}}
.card-gallery{position:relative;overflow:hidden}
.card-track{display:flex;transition:transform .32s ease;touch-action:pan-y}
.card-slide{flex:0 0 100%;min-width:100%}
.card-dots{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);z-index:3;background:rgba(10,30,27,.45);padding:5px 8px;border-radius:999px}
.card-count{position:absolute;bottom:8px;right:8px;z-index:3;background:rgba(10,30,27,.65);color:#fff;font-size:11px;font-weight:800;padding:3px 8px;border-radius:999px}
.badge{position:absolute;top:10px;left:10px;background:var(--orange);color:#fff;font-size:11px;font-weight:800;padding:4px 9px;border-radius:999px}
.badge.dark{background:var(--teal2)}
.stock{position:absolute;top:10px;right:10px;background:rgba(10,30,27,.78);color:#BFF0DD;font-size:11px;font-weight:700;padding:4px 9px;border-radius:999px}
.card-body{padding:14px;display:flex;flex-direction:column;gap:6px;flex:1}
.card-body h3{font-size:16.5px;cursor:pointer}
.card-body h3:hover{color:var(--orange)}
.latin{font-size:12px;color:var(--muted);font-style:italic;margin-top:-4px}
.card-body p.desc{font-size:13.5px;color:var(--muted);margin:0;flex:1}
.meta{display:flex;gap:6px;flex-wrap:wrap}
.meta span{font-size:11px;font-weight:700;background:var(--surface2);border:1px solid var(--line);padding:3px 8px;border-radius:999px}
.price-row{display:flex;align-items:center;gap:8px;margin-top:6px}
.price{font-family:"Sora";font-weight:800;font-size:17px}
.price small{font-family:"Plus Jakarta Sans";font-weight:600;font-size:12px;color:var(--muted)}
.price-old{font-size:13px;color:var(--muted);text-decoration:line-through}
.add-btn{margin-top:8px;width:100%;justify-content:center}
.empty{grid-column:1/-1;text-align:center;padding:36px 16px;color:var(--muted);background:var(--surface);border:1px dashed var(--line);border-radius:var(--radius)}

/* steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:900px){.steps{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.steps{grid-template-columns:1fr}}
.step{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
.step .num{font-family:"Sora";font-weight:800;font-size:28px;color:var(--gold)}
.step h3{font-size:16.5px;margin:8px 0 6px}
.step p{font-size:14px;color:var(--muted);margin:0}

/* guarantee band */
.band{background:var(--teal2);color:#EAF6F1;border-radius:26px;padding:30px;display:grid;grid-template-columns:1.1fr .9fr;gap:26px;align-items:center;overflow:hidden}
@media(max-width:860px){.band{grid-template-columns:1fr;padding:22px}}
.band h2{color:#fff;font-size:clamp(24px,3vw,34px)}
.band p{color:#BFDCD2}
.band img{width:100%;height:280px;object-fit:cover;border-radius:18px}
.g-list{display:grid;gap:12px;margin-top:18px}
.g-list div{display:flex;gap:12px;align-items:flex-start;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:13px 14px}
.g-list b{color:#fff;display:block;font-size:15px}
.g-list span{font-size:13.5px;color:#BFDCD2}
.g-ico{font-size:20px;line-height:1.2}

/* care */
.care{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:820px){.care{grid-template-columns:1fr}}
.care article{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
.care h3{font-size:16px;margin-bottom:6px}
.care p{font-size:14px;color:var(--muted);margin:0}
.care .big{font-family:"Sora";font-weight:800;font-size:22px;color:var(--teal)}
@media(prefers-color-scheme:dark){.care .big{color:#8ED8C8}}

/* faq */
.faq-list{display:grid;gap:10px;max-width:820px}
.faq{background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.faq button{width:100%;text-align:left;background:none;border:0;cursor:pointer;font:inherit;font-weight:700;font-size:15.5px;padding:16px 18px;display:flex;justify-content:space-between;gap:14px;color:var(--ink)}
.faq .ans{display:none;padding:0 18px 16px;font-size:14.5px;color:var(--muted)}
.faq.open .ans{display:block}
.faq .chev{transition:.2s;color:var(--orange)}
.faq.open .chev{transform:rotate(45deg)}

/* wholesale + cta */
.split{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:820px){.split{grid-template-columns:1fr}}
.panel{border-radius:22px;padding:26px}
.panel.wholesale{background:var(--surface);border:1.5px solid var(--line)}
.panel.wholesale ul{margin:12px 0 18px;padding-left:18px;color:var(--muted);font-size:14.5px;display:grid;gap:6px}
.panel.cta-panel{background:var(--orange);color:#fff}
.panel.cta-panel p{color:#FFE3D1}
.tier{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px dashed var(--line);font-size:14.5px}
.tier:last-of-type{border-bottom:0}
.tier b{font-family:"Sora"}

/* shipping */
.ship-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:820px){.ship-grid{grid-template-columns:1fr}}
.ship-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
.ship-card .courier{font-family:"Sora";font-weight:800;font-size:22px;color:var(--teal);letter-spacing:.02em}
@media(prefers-color-scheme:dark){.ship-card .courier{color:#8ED8C8}}
.ship-card h3{font-size:15.5px;margin:8px 0 6px}
.ship-card p{font-size:14px;color:var(--muted);margin:0}
.ship-notes{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
@media(max-width:820px){.ship-notes{grid-template-columns:1fr}}
.ship-note{background:var(--teal-soft);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px}
.ship-note h3{font-size:15.5px;margin-bottom:6px}
.ship-note p{font-size:14px;color:var(--muted);margin:0}
.ship-picker{margin:0 0 12px}
.ship-picker>span{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:8px}
.ship-opts{display:flex;gap:8px;flex-wrap:wrap}
.ship-btn{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);font-weight:800;font-size:13.5px;padding:9px 16px;border-radius:999px;cursor:pointer}
.ship-btn.active{background:var(--teal);border-color:var(--teal);color:#fff}
.ship-info{font-size:12.5px;color:var(--muted);margin:8px 0 0}
.recipient-form{margin:14px 0 4px;padding-top:14px;border-top:1px dashed var(--line)}
.recipient-form>span{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:4px}
.recipient-form .hint{font-size:12.5px;color:var(--muted);margin:0 0 10px}
.field{margin-bottom:10px}
.field label{display:block;font-size:13px;font-weight:700;margin-bottom:5px}
.field label small{font-weight:600;color:var(--muted)}
.field input,.field textarea{width:100%;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);border-radius:12px;padding:11px 12px;font:inherit;font-size:14px;outline:none;resize:vertical}
.field input:focus,.field textarea:focus{border-color:var(--teal)}
.field input.invalid,.field textarea.invalid{border-color:#D64545;background:color-mix(in srgb,#D64545 6%,var(--surface))}
.form-error{display:none;font-size:13px;font-weight:700;color:#B42318;background:#FEF2F2;border:1px solid #FECDC2;border-radius:10px;padding:9px 11px;margin:0 0 10px}
@media(prefers-color-scheme:dark){.form-error{color:#FECDC2;background:#3A1D18;border-color:#7A2E1F}}
.form-error.show{display:block}

/* footer */
footer.site{margin-top:56px;background:var(--teal2);color:#C9E2D9}
footer.site .wrap{padding-top:36px;padding-bottom:28px;display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:26px}
@media(max-width:820px){footer.site .wrap{grid-template-columns:1fr}}
footer.site h4{color:#fff;font-family:"Sora";margin:0 0 10px;font-size:15px}
footer.site a{color:#C9E2D9;text-decoration:none;display:block;padding:3px 0;font-size:14px}
footer.site a:hover{color:#fff}
footer.site p{font-size:14px;margin:0}
.copyright{border-top:1px solid rgba(255,255,255,.14);margin-top:8px;padding-top:16px;font-size:12.5px;color:#8FB3A7;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;grid-column:1/-1}

/* floating WA */
.wa-float{position:fixed;right:16px;bottom:16px;z-index:60;width:56px;height:56px;border-radius:50%;background:var(--wa);color:#fff;display:grid;place-items:center;font-size:26px;text-decoration:none;box-shadow:0 12px 28px rgba(20,90,50,.35)}

/* cart drawer + modal */
.overlay{position:fixed;inset:0;background:rgba(8,20,17,.55);z-index:80;display:none}
.overlay.show{display:block}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(420px,94vw);background:var(--bg);z-index:90;display:none;flex-direction:column;box-shadow:-16px 0 40px rgba(0,0,0,.25)}
.drawer.open{display:flex;animation:slideIn .25s ease}
@keyframes slideIn{from{transform:translateX(40px);opacity:.4}to{transform:none;opacity:1}}
.cart-btn{white-space:nowrap;flex:none}
.drawer header{padding:18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.drawer header h3{font-size:18px}
.icon-btn{border:1.5px solid var(--line);background:var(--surface);width:38px;height:38px;border-radius:50%;cursor:pointer;font-size:16px;color:var(--ink);display:grid;place-items:center;flex:none}
.cart-items{flex:1;overflow:auto;padding:14px 18px;display:grid;gap:12px;align-content:start}
.cart-item{display:flex;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:10px}
.cart-item img{width:64px;height:64px;border-radius:10px;object-fit:cover}
.cart-item b{font-size:14px;display:block}
.cart-item .cp{font-size:13px;color:var(--muted)}
.qty{display:inline-flex;align-items:center;gap:2px;border:1.5px solid var(--line);border-radius:999px;margin-top:6px;overflow:hidden}
.qty button{width:28px;height:28px;border:0;background:var(--surface2);cursor:pointer;font-weight:800;color:var(--ink)}
.qty span{min-width:26px;text-align:center;font-weight:800;font-size:13.5px}
.remove{margin-left:auto;align-self:flex-start}
.drawer footer{padding:16px 18px;border-top:1px solid var(--line);background:var(--surface);max-height:68vh;overflow-y:auto}
.total-row{display:flex;justify-content:space-between;font-weight:800;font-family:"Sora";font-size:17px;margin-bottom:6px}
.note{font-size:12.5px;color:var(--muted);margin:0 0 12px}
.drawer footer .btn{width:100%;justify-content:center;margin-top:8px}
.cart-empty{text-align:center;color:var(--muted);padding:40px 10px;font-size:14.5px}

.modal{position:fixed;inset:0;z-index:95;display:none;place-items:center;padding:16px}
.modal.show{display:grid}
.modal-box{background:var(--bg);border-radius:22px;max-width:760px;width:100%;max-height:92vh;overflow:auto;position:relative;z-index:2}
.modal-grid{display:grid;grid-template-columns:1fr 1fr}
@media(max-width:680px){.modal-grid{grid-template-columns:1fr}}
.modal-media{display:flex;flex-direction:column;min-height:260px}
.gallery{position:relative;overflow:hidden;flex:1;min-height:260px;background:var(--surface2);touch-action:pan-y}
.gallery-track{display:flex;height:100%;min-height:260px;transition:transform .35s ease}
.gallery-slide{flex:0 0 100%;min-width:100%}
.gallery-slide img{width:100%;height:100%;min-height:260px;object-fit:cover}
.gallery-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);color:var(--ink);font-size:19px;font-weight:800;cursor:pointer;display:grid;place-items:center;box-shadow:var(--shadow)}
.gallery-nav.prev{left:10px}.gallery-nav.next{right:10px}
.gallery-nav[hidden]{display:none}
